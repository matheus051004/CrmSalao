<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Dashboard | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Dashboard</h2>
        {#        <div>#}
        {#            <button class="btn btn-outline-secondary me-2 d-none d-sm-inline-block"><i class="fas fa-download me-1"></i>#}
        {#                Exportar#}
        {#            </button>#}
        {#            <button class="btn btn-primary"><i class="fas fa-plus me-1"></i> Novo Lead</button>#}
        {#        </div>#}
    </div>

    <!-- Stats Row -->
    <div class="row">
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div id="clientes_count" class="stat-value">Aguarde...</div>
                            <div class="stat-label">Total de Clientes</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div id="clientes_mes_count" class="stat-value">Aguarde...</div>
                            <div class="stat-label">Clientes últimos 30 dias</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div id="today_agendamentos" class="stat-value">Aguarde...</div>
                            <div class="stat-label">Agendamentos hoje</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">R$ <span id="month_faturamento"></span></div>
                            <div class="stat-label">Faturamento do Mês</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Clientes e agendamentos - Anual</h5>
                    <div class="chart-container">
                        <canvas id="clientesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Agendamentos por profissional</h5>
                        <select class="form-select form-select-sm" style="width: auto;" id="periodoFilter">
                            <option value="dia">Diário</option>
                            <option value="semana">Semanal</option>
                            <option value="mes" selected>Mensal</option>
                        </select>
                    </div>
                    <div class="chart-container">
                        <canvas id="leadStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Faturamento - Anual</h5>
                    <div class="chart-container">
                        <canvas id="faturamentoChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% include 'parts/foot.jinja2' %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        fetch('{{ url_for('ajax-dashboard') }}'.replace('http', 'https')).then(res => {
            (async () => {
                const data = await res.json()
                document.getElementById('clientes_count').innerHTML = data.clientes_count
                document.getElementById('clientes_mes_count').innerHTML = data.clientes_mes_count
                document.getElementById('today_agendamentos').innerHTML = data.today_agendamentos
                document.getElementById('month_faturamento').innerHTML = new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }).format(data.month_faturamento)
                charts(data)
            })()
        })
    })

    function charts(data) {
        // clientes chart
        const clientesCtx = document.getElementById('clientesChart').getContext('2d');
        const clientesChart = new Chart(clientesCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Outubro', 'Nov', 'Dez'],
                datasets: [{
                    label: 'Clientes',
                    data: [data.clientes_jan, data.clientes_feb, data.clientes_mar, data.clientes_apr, data.clientes_may, data.clientes_jun, data.clientes_jul, data.clientes_aug, data.clientes_sep, data.clientes_oct, data.clientes_nov, data.clientes_dec],
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderColor: 'rgb(54, 162, 235)',
                    borderWidth: 1
                }, {
                    label: 'Agendamentos',
                    data: [data.agendamentos_jan, data.agendamentos_feb, data.agendamentos_mar, data.agendamentos_apr, data.agendamentos_may, data.agendamentos_jun, data.agendamentos_jul, data.agendamentos_aug, data.agendamentos_sep, data.agendamentos_oct, data.agendamentos_nov, data.agendamentos_dec],
                    backgroundColor: 'rgba(75, 192, 192, 0.5)',
                    borderColor: 'rgb(75, 192, 192)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // faturamento chart
        const faturamentoCtx = document.getElementById('faturamentoChart').getContext('2d');
        new Chart(faturamentoCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
                datasets: [
                    {
                        label: 'Previsto',
                        data: [
                            data.monthly_faturamento_previsto[0],
                            data.monthly_faturamento_previsto[1],
                            data.monthly_faturamento_previsto[2],
                            data.monthly_faturamento_previsto[3],
                            data.monthly_faturamento_previsto[4],
                            data.monthly_faturamento_previsto[5],
                            data.monthly_faturamento_previsto[6],
                            data.monthly_faturamento_previsto[7],
                            data.monthly_faturamento_previsto[8],
                            data.monthly_faturamento_previsto[9],
                            data.monthly_faturamento_previsto[10],
                            data.monthly_faturamento_previsto[11]
                        ],
                        backgroundColor: 'rgba(235,226,54,0.5)',
                        borderColor: 'rgb(235,232,54)',
                        borderWidth: 1
                    },
                    {
                        label: 'Confirmado',
                        data: [
                            data.monthly_faturamento[0],
                            data.monthly_faturamento[1],
                            data.monthly_faturamento[2],
                            data.monthly_faturamento[3],
                            data.monthly_faturamento[4],
                            data.monthly_faturamento[5],
                            data.monthly_faturamento[6],
                            data.monthly_faturamento[7],
                            data.monthly_faturamento[8],
                            data.monthly_faturamento[9],
                            data.monthly_faturamento[10],
                            data.monthly_faturamento[11]
                        ],
                        backgroundColor: 'rgba(87,235,54,0.5)',
                        borderColor: 'rgb(99,235,54)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return new Intl.NumberFormat('pt-BR', {
                                    style: 'currency',
                                    currency: 'BRL'
                                }).format(value);
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += new Intl.NumberFormat('pt-BR', {
                                    style: 'currency',
                                    currency: 'BRL'
                                }).format(context.parsed.y);
                                return label;
                            }
                        }
                    }
                }
            }
        });
    }
</script>
</body>
</html>
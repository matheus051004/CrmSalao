<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Dashboard | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Dashboard</h2>
{#        <div>#}
{#            <button class="btn btn-outline-secondary me-2 d-none d-sm-inline-block"><i class="fas fa-download me-1"></i>#}
{#                Exportar#}
{#            </button>#}
{#            <button class="btn btn-primary"><i class="fas fa-plus me-1"></i> Novo Lead</button>#}
{#        </div>#}
    </div>

    <!-- Stats Row -->
    <div class="row">
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">127</div>
                            <div class="stat-label">Total de Leads</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">43</div>
                            <div class="stat-label">Leads Novos</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">R$ 4.280</div>
                            <div class="stat-label">Faturamento do Mês</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">65%</div>
                            <div class="stat-label">Taxa de Conversão</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Leads por Mês</h5>
                    <div class="chart-container">
                        <canvas id="leadsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Status dos Leads</h5>
                    <div class="chart-container">
                        <canvas id="leadStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% include 'parts/foot.jinja2' %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        fetch('{{ url_for('ajax-dashboard') }}').then(res => {

        })
    })
</script>
</body>
</html>
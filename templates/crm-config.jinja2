<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Configurações | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Configurações</h2>
    </div>


    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Configurações Gerais</h5>
                    <div>
                        <label class="form-label">Nome do salão</label>
                        <input type="text" class="form-control" id="crm_name" value="{{ crm_name }}">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Mensagens</h5>
                    <div class="mb-3">
                        <label class="form-label">Mensagem de conclusão</label>
                        <small class="form-text text-muted d-block">Esta mensagem será enviada quando um agendamento for concluído</small>
                        <small class="form-text text-muted mb-2 d-block">Variáveis: {cliente_name} {salao_name}.</small>
                        <textarea id="msg_preference" class="form-control" rows="8">{{ app_settings('msg_preference') }}</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mensagem de cancelamento</label>
                        <small class="form-text text-muted d-block">Esta mensagem será enviada quando um agendamento for cancelado</small>
                        <small class="form-text text-muted mb-2 d-block"><code>Variáveis: {cliente_name} {salao_name}.</code></small>
                        <textarea id="msg_cancel" class="form-control" rows="8">{{ app_settings('msg_cancel') }}</textarea>
                    </div>
                    <div>
                        <label class="form-label">Mensagem Follow-UP</label>
                        <textarea id="msg_cancel" class="form-control" rows="8">{{ app_settings('msg_follow_up') }}</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- row end -->
</div> <!-- main-content end -->

{% include 'parts/foot.jinja2' %}
</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Configurações | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Configurações</h2>
    </div>


    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Configurações Gerais</h5>
                    <div>
                        <label class="form-label">Nome do sistema</label>
                        <input type="text" class="form-control" id="crm_name" value="{{ crm_name }}">
                    </div>
                </div> <!-- card-body end -->
            </div> <!-- card end -->
        </div> <!-- col end -->
    </div> <!-- row end -->
</div> <!-- main-content end -->

{% include 'parts/foot.jinja2' %}
</body>
</html>
        <h4><i class="fas fa-cut me-2 logo-icon"></i> {{ crm_name() }}</h4>
        <button class="btn btn-sm d-none d-lg-block" id="sidebarCollapseBtn">
            <i class="fas fa-chevron-left"></i>
        </button>
    </div>
    <div class="sidebar-menu">
        <a href="{{ url_for('dashboard') }}" class="{% if sidebar == 'dashboard' %}active{% endif %}"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="{{ url_for('clientes') }}" class="{% if sidebar == 'clientes' %}active{% endif %}"><i class="fas fa-users"></i> Clientes</a>

        <a href="{{ url_for('profissionais') }}" class="{% if sidebar == 'profissionais' %}active{% endif %}"><i class="fa-solid fa-address-card"></i> Profissionais</a>
        <a href="{{ url_for('configuracoes') }}" class="{% if sidebar == 'configuracoes' %}active{% endif %}"><i class="fas fa-cog"></i> Configurações</a>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Dashboard | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Dashboard</h2>
        <div>
            <button class="btn btn-outline-secondary me-2 d-none d-sm-inline-block"><i class="fas fa-download me-1"></i>
                Exportar
            </button>
            <button class="btn btn-primary"><i class="fas fa-plus me-1"></i> Novo Lead</button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row">
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">127</div>
                            <div class="stat-label">Total de Leads</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">43</div>
                            <div class="stat-label">Leads Novos</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">R$ 4.280</div>
                            <div class="stat-label">Faturamento do Mês</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card card-stat">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-value">65%</div>
                            <div class="stat-label">Taxa de Conversão</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Leads por Mês</h5>
                    <div class="chart-container">
                        <canvas id="leadsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Status dos Leads</h5>
                    <div class="chart-container">
                        <canvas id="leadStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leads Table -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3">
                <h5 class="card-title mb-2 mb-sm-0">Leads Recentes</h5>
                <div class="input-group" style="max-width: 250px;">
                    <input type="text" class="form-control" placeholder="Pesquisar leads...">
                    <button class="btn btn-outline-secondary" type="button"><i class="fas fa-search"></i></button>
                </div>
            </div>

            <div class="table-responsive leads-table">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Telefone</th>
                        <th>Origem</th>
                        <th>Status</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://via.placeholder.com/36" class="me-3" alt="Avatar">
                                <div>
                                    <div class="fw-bold">João Silva</div>
                                    <div class="small text-muted">joao@email.com</div>
                                </div>
                            </div>
                        </td>
                        <td>(11) 99999-1234</td>
                        <td>Instagram</td>
                        <td><span class="badge bg-warning">Em contato</span></td>
                        <td>15/09/2023</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-sm btn-outline-success"><i class="fab fa-whatsapp"></i></button>
                            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-ellipsis-v"></i></button>
                        </td>
                    </tr>
                    <!-- Outros registros da tabela mantidos iguais -->
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://via.placeholder.com/36" class="me-3" alt="Avatar">
                                <div>
                                    <div class="fw-bold">Maria Oliveira</div>
                                    <div class="small text-muted">maria@email.com</div>
                                </div>
                            </div>
                        </td>
                        <td>(11) 98888-5678</td>
                        <td>Facebook</td>
                        <td><span class="badge bg-success">Convertido</span></td>
                        <td>12/09/2023</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-sm btn-outline-success"><i class="fab fa-whatsapp"></i></button>
                            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-ellipsis-v"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://via.placeholder.com/36" class="me-3" alt="Avatar">
                                <div>
                                    <div class="fw-bold">Pedro Santos</div>
                                    <div class="small text-muted">pedro@email.com</div>
                                </div>
                            </div>
                        </td>
                        <td>(11) 97777-9876</td>
                        <td>Site</td>
                        <td><span class="badge bg-info">Novo</span></td>
                        <td>10/09/2023</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-sm btn-outline-success"><i class="fab fa-whatsapp"></i></button>
                            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-ellipsis-v"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://via.placeholder.com/36" class="me-3" alt="Avatar">
                                <div>
                                    <div class="fw-bold">Ana Souza</div>
                                    <div class="small text-muted">ana@email.com</div>
                                </div>
                            </div>
                        </td>
                        <td>(11) 96666-4321</td>
                        <td>Indicação</td>
                        <td><span class="badge bg-danger">Perdido</span></td>
                        <td>05/09/2023</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-sm btn-outline-success"><i class="fab fa-whatsapp"></i></button>
                            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-ellipsis-v"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://via.placeholder.com/36" class="me-3" alt="Avatar">
                                <div>
                                    <div class="fw-bold">Carlos Ferreira</div>
                                    <div class="small text-muted">carlos@email.com</div>
                                </div>
                            </div>
                        </td>
                        <td>(11) 95555-8765</td>
                        <td>Google</td>
                        <td><span class="badge bg-primary">Agendado</span></td>
                        <td>01/09/2023</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-phone"></i></button>
                            <button class="btn btn-sm btn-outline-success"><i class="fab fa-whatsapp"></i></button>
                            <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-ellipsis-v"></i></button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                <div class="mb-2 mb-sm-0">Mostrando 1-5 de 127 leads</div>
                <nav>
                    <ul class="pagination mb-0 justify-content-center justify-content-sm-end">
                        <li class="page-item disabled"><a class="page-link" href="#">Anterior</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">Próximo</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
{% include 'parts/foot.jinja2' %}
</body>
</html>
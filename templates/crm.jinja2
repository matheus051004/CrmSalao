<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Dashboard CRM</title>
    {% include 'parts/head.jinja2' %}
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            transition: all 0.3s;
        }

        .sidebar {
            background-color: #ffffff;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            height: 100vh;
            position: fixed;
            width: 250px;
            transition: all 0.3s;
            z-index: 1000;
            left: 0;
        }

        .sidebar-collapsed .sidebar {
            left: -250px;
        }

        .sidebar-logo {
            padding: 1.5rem;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-logo i.logo-icon {
            color: var(--bs-primary);
        }

        .sidebar-menu {
            padding: 1rem 0;
        }

        .sidebar-menu a {
            color: #495057;
            display: block;
            padding: 0.75rem 1.5rem;
            text-decoration: none;
            transition: all 0.3s;
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            background-color: rgba(var(--bs-primary-rgb), 0.1);
            color: var(--bs-primary);
        }

        .sidebar-menu i {
            margin-right: 0.75rem;
            width: 20px;
        }

        .main-content {
            margin-left: 250px;
            padding: 2rem;
            transition: all 0.3s;
        }

        .sidebar-collapsed .main-content {
            margin-left: 0;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.05);
            margin-bottom: 1.5rem;
        }

        .card-stat {
            border-left: 4px solid var(--bs-primary);
        }

        .card-stat .card-body {
            padding: 1.5rem;
        }

        .card-stat .stat-icon {
            background-color: rgba(var(--bs-primary-rgb), 0.1);
            border-radius: 50%;
            color: var(--bs-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 48px;
            width: 48px;
        }

        .card-stat .stat-icon i {
            font-size: 1.25rem;
        }

        .card-stat .stat-value {
            font-size: 1.75rem;
            font-weight: 600;
        }

        .card-stat .stat-label {
            color: #6c757d;
            font-size: 0.875rem;
        }

        .leads-table img {
            height: 36px;
            width: 36px;
            object-fit: cover;
            border-radius: 50%;
        }

        .chart-container {
            position: relative;
            height: 300px;
        }

        .navbar-toggler {
            display: none;
            margin-right: 1rem;
            border: none;
            background: transparent;
            color: var(--bs-primary);
            font-size: 1.5rem;
            padding: 0.5rem;
        }

        .mobile-header {
            display: none;
            background-color: #fff;
            padding: 1rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        @media (max-width: 991.98px) {
            .sidebar {
                left: -250px;
            }

            .main-content {
                margin-left: 0;
                padding: 1rem;
            }

            .navbar-toggler {
                display: block;
            }

            .mobile-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .sidebar-expanded .sidebar {
                left: 0;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                z-index: 999;
            }

            .sidebar-expanded .sidebar-overlay {
                display: block;
            }
        }
    </style>
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> CRM Barbearia</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->

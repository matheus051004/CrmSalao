<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Agendamentos | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Agendamentos</h2>
    </div>


    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">

                    <!-- Filtros -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <form id="filterForm" method="get" class="row g-3">
                                <div class="col-md-6">
                                    <label for="cliente_id" class="form-label">Cliente</label>
                                    <select id="cliente_id" name="cliente_id" class="form-select">
                                        <option value="0" {% if cliente_id == 0 %}selected{% endif %}>Todos os
                                            clientes
                                        </option>
                                        {% for cliente in clientes %}
                                            <option value="{{ cliente.id }}"
                                                    {% if cliente_id == cliente.id %}selected{% endif %}>
                                                {{ cliente.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="status" class="form-label">Status</label>
                                    <select id="status" name="status" class="form-select">
                                        <option value="todos" {% if status == 'todos' %}selected{% endif %}>
                                            Todos
                                        </option>
                                        <option value="agendado"
                                                {% if status == 'agendado' %}selected{% endif %}>Agendado
                                        </option>
                                        <option value="concluido"
                                                {% if status == 'concluido' %}selected{% endif %}>Concluído
                                        </option>
                                        <option value="cancelado"
                                                {% if status == 'cancelado' %}selected{% endif %}>Cancelado
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary me-2">Filtrar</button>
                                    <a href="{{ url_for('agendamentos') }}" class="btn btn-secondary">Limpar
                                        filtros</a>
                                </div>

                                <!-- Campos ocultos para manter a paginação e ordenação -->
                                <input type="hidden" name="page" value="1">
                                <input type="hidden" name="per_page" value="{{ per_page }}">
                                <input type="hidden" name="order_by" value="{{ order_by }}">
                                <input type="hidden" name="order" value="{{ order }}">
                            </form>
                        </div>
                    </div>

                    <!-- Per Page Selection + Count Display -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <form id="perPageForm" class="d-flex align-items-center">
                                <label for="per_page" class="form-label me-2 mb-0">Mostrar:</label>
                                <select id="per_page" name="per_page" class="form-select form-select-sm"
                                        style="width: auto;" onchange="this.form.submit()">
                                    <option value="10" {% if per_page == 10 %}selected{% endif %}>10</option>
                                    <option value="25" {% if per_page == 25 %}selected{% endif %}>25</option>
                                    <option value="50" {% if per_page == 50 %}selected{% endif %}>50</option>
                                    <option value="100" {% if per_page == 100 %}selected{% endif %}>100</option>
                                </select>
                                <input type="hidden" name="page" value="{{ page }}">
                                <input type="hidden" name="order_by" value="{{ order_by }}">
                                <input type="hidden" name="order" value="{{ order }}">
                            </form>
                        </div>
                        <div>
                            <span class="text-muted">
                                Mostrando {{ start_item }}-{{ end_item }} de {{ total }} clientes
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th scope="col">
                                    <a href="{{ url_for('agendamentos') }}?page={{ page }}&per_page={{ per_page }}&order_by=id&order={{ 'asc' if order_by == 'id' and order == 'desc' else 'desc' }}&cliente_id={{ cliente_id }}&status={{ status }}">
                                        ID
                                        {% if order_by == 'id' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">Nome</th>
                                <th scope="col">Status</th>
                                <th scope="col">Serviços</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Profissional</th>
                                <th scope="col">Início</th>
                                <th scope="col">Término</th>
                                <th scope="col">Ação</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if items %}
                                {% for item in items %}
                                    <tr>
                                        <td class="align-middle">{{ item.id }}</td>
                                        <td class="align-middle">{{ item.title }}</td>
                                        <td class="align-middle">
                                            {% if item.status == 'agendado' %}
                                                <span class="badge bg-warning">Agendado</span>
                                            {% elif item.status == 'concluido' %}
                                                <span class="badge bg-success">Concluido</span>
                                            {% elif item.status == 'cancelado' %}
                                                <span class="badge bg-danger">Cancelado</span>
                                            {% endif %}
                                        </td>
                                        <td class="align-middle">
                                            <a href="javascript:void(0)"
                                               onclick="alert(`{{ get_servicos_string(item.servicos) }}`)">VER</a>
                                        </td>
                                        <td class="align-middle">
                                            <a href="{{ url_for('clientes') }}?search={{ get_cliente(item.cliente_id).name }}">
                                                {{ get_cliente(item.cliente_id).name }}
                                            </a>
                                        </td>
                                        <td class="align-middle">{{ get_profissional(item.profissional_id).name }}</td>
                                        <td class="align-middle">{{ reformat_date_time(item.start, '%d-%m %H:%M') }}</td>
                                        <td class="align-middle">{{ reformat_date_time(item.end, '%d-%m %H:%M') }}</td>
                                        <td>
                                            <div class="d-flex gap-2 flex-column">
                                                <button onclick="concluirAgendamento('{{ item.id }}', '{{ item.title }}')"
                                                        class="btn btn-success"><i class="fa-solid fa-check"></i>
                                                    Concluir
                                                </button>
                                                <button class="btn btn-danger"><i class="fa-solid fa-power-off"></i>
                                                    Cancelar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="9" class="text-center">Nenhum agendamento encontrado.</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Start -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <!-- Previous Page Link -->
                            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ url_for('agendamentos') }}?page={{ page - 1 }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}&cliente_id={{ cliente_id }}&status={{ status }}"
                                   aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            <!-- Page Number Links -->
                            {% set page_range = 2 %}
                            {% set start_page = [1, page - page_range]|max %}
                            {% set end_page = [total_pages, page + page_range]|min %}

                            <!-- Primeira página sempre -->
                            {% if start_page > 1 %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ url_for('agendamentos') }}?page=1&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}&cliente_id={{ cliente_id }}&status={{ status }}">1</a>
                                </li>
                                {% if start_page > 2 %}
                                    <li class="page-item disabled">
                                        <a class="page-link">...</a>
                                    </li>
                                {% endif %}
                            {% endif %}

                            <!-- Páginas ao redor da página atual -->
                            {% for page_num in range(start_page, end_page + 1) %}
                                <li class="page-item {% if page_num == page %}active{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('agendamentos') }}?page={{ page_num }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}&cliente_id={{ cliente_id }}&status={{ status }}">{{ page_num }}</a>
                                </li>
                            {% endfor %}

                            <!-- Última página sempre -->
                            {% if end_page < total_pages %}
                                {% if end_page < total_pages - 1 %}
                                    <li class="page-item disabled">
                                        <a class="page-link">...</a>
                                    </li>
                                {% endif %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ url_for('agendamentos') }}?page={{ total_pages }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}&cliente_id={{ cliente_id }}&status={{ status }}">{{ total_pages }}</a>
                                </li>
                            {% endif %}

                            <!-- Next Page Link -->
                            <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ url_for('agendamentos') }}?page={{ page + 1 }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}&cliente_id={{ cliente_id }}&status={{ status }}"
                                   aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <!-- Pagination End -->

                </div> <!-- card-body end -->
            </div> <!-- card end -->
        </div> <!-- col end -->
    </div> <!-- row end -->
</div> <!-- main-content end -->

{% include 'parts/foot.jinja2' %}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Adicionar os parâmetros de filtro ao formulário per_page
        const perPageForm = document.getElementById('perPageForm');
        if (perPageForm) {
            const clienteIdInput = document.createElement('input');
            clienteIdInput.type = 'hidden';
            clienteIdInput.name = 'cliente_id';
            clienteIdInput.value = '{{ cliente_id }}';
            perPageForm.appendChild(clienteIdInput);

            const statusInput = document.createElement('input');
            statusInput.type = 'hidden';
            statusInput.name = 'status';
            statusInput.value = '{{ status }}';
            perPageForm.appendChild(statusInput);
        }
    });

    function concluirAgendamento(id, name) {
        const concluirModal = new bootstrap.Modal(document.getElementById('concluirModal'));
        document.querySelector('.cliente-name').textContent = name;
        document.querySelector('.concluir').onclick = function () {
            const message = document.querySelector('.concluir-message').value;
            const notify = document.getElementById('notifyCheck').checked;

            const url = '{{ url_for('ajax-concluir-agendamento') }}'.replace('http', 'https')
            fetch(url, {
                'method': 'POST',
                'headers': {
                    'Content-Type': 'application/json'
                },
                'body': JSON.stringify({
                    'agendamento_id': id,
                    'message': message,
                    'notify_cliente': notify
                })
            }).then(res => {
                const notyf = new Notyf();
                (async () => {
                    const data = await res.json();
                    if (data.success) {
                        notyf.success(data.message)
                        setTimeout(() => {
                            window.location.reload();
                        }, 2000);
                    } else {
                        notyf.error(data.message)
                    }
                })()
            })
        }
        concluirModal.show();
    }
</script>


<!-- Modal concluir agendamento -->
<div class="modal fade" id="concluirModal" tabindex="-1" aria-labelledby="concluirModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="concluirModalLabel">Concluir agendamento: <span class="cliente-name"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" value="" id="notifyCheck" checked>
                    <label class="form-check-label" for="notifyCheck">
                        Notificar cliente?
                    </label>
                </div>
                <textarea class="form-control concluir-message" rows="10"
                          placeholder="Digite sua mensagem aqui...">{{ app_settings('msg_preference') }}</textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success concluir">Confirmar</button>
            </div>
        </div>
    </div>
</div>


</body>
</html>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Clientes | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Clientes</h2>
    </div>


    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <!-- Per Page Selection + Count Display -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <form id="perPageForm" class="d-flex align-items-center">
                                <label for="per_page" class="form-label me-2 mb-0">Mostrar:</label>
                                <select id="per_page" name="per_page" class="form-select form-select-sm"
                                        style="width: auto;" onchange="this.form.submit()">
                                    <option value="10" {% if per_page == 10 %}selected{% endif %}>10</option>
                                    <option value="25" {% if per_page == 25 %}selected{% endif %}>25</option>
                                    <option value="50" {% if per_page == 50 %}selected{% endif %}>50</option>
                                    <option value="100" {% if per_page == 100 %}selected{% endif %}>100</option>
                                </select>
                                <input type="hidden" name="page" value="{{ page }}">
                                <input type="hidden" name="order_by" value="{{ order_by }}">
                                <input type="hidden" name="order" value="{{ order }}">
                            </form>
                        </div>
                        <div>
                            <span class="text-muted">
                                Mostrando {{ start_item }}-{{ end_item }} de {{ total }} clientes
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th scope="col">
                                    <a href="{{ url_for('clientes') }}?page={{ page }}&per_page={{ per_page }}&order_by=id&order={{ 'asc' if order_by == 'id' and order == 'desc' else 'desc' }}">
                                        ID
                                        {% if order_by == 'id' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">
                                    <a href="{{ url_for('clientes') }}?page={{ page }}&per_page={{ per_page }}&order_by=name&order={{ 'asc' if order_by == 'name' and order == 'desc' else 'desc' }}">
                                        Nome
                                        {% if order_by == 'name' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">
                                    <a href="{{ url_for('clientes') }}?page={{ page }}&per_page={{ per_page }}&order_by=email&order={{ 'asc' if order_by == 'email' and order == 'desc' else 'desc' }}">
                                        E-mail
                                        {% if order_by == 'email' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">Telefone</th> <!-- Add sorting link if needed -->
                                <th scope="col">Ações</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if items %}
                                {% for item in items %}
                                    <tr>
                                        <td>{{ item.id }}</td>
                                        <td>{{ item.name }}</td>
                                        <td>{{ item.email }}</td>
                                        <td>{{ item.phone }}</td>
                                        <td>
                                            <a href="javascript:void(0)" onclick="whatsappModal('{{ item.name }}', '{{ item.phone }}')"
                                               class="btn btn-sm btn-success send-whatsapp-message">
                                                <i class="fa-brands fa-whatsapp"></i>
                                            </a>
                                            <a href="mailto:{{ item.email }}" class="btn btn-sm btn-dark">
                                                <i class="fas fa-envelope"></i>
                                            </a>
                                            <a href="#" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Nenhum cliente encontrado.</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Start -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <!-- Previous Page Link -->
                            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ url_for('clientes') }}?page={{ page - 1 }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}"
                                   aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            <!-- Page Number Links -->
                            {% set page_range = 2 %}
                            {% set start_page = [1, page - page_range]|max %}
                            {% set end_page = [total_pages, page + page_range]|min %}

                            <!-- Primeira página sempre -->
                            {% if start_page > 1 %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ url_for('clientes') }}?page=1&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}">1</a>
                                </li>
                                {% if start_page > 2 %}
                                    <li class="page-item disabled">
                                        <a class="page-link">...</a>
                                    </li>
                                {% endif %}
                            {% endif %}

                            <!-- Páginas ao redor da página atual -->
                            {% for page_num in range(start_page, end_page + 1) %}
                                <li class="page-item {% if page_num == page %}active{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('clientes') }}?page={{ page_num }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}">{{ page_num }}</a>
                                </li>
                            {% endfor %}

                            <!-- Última página sempre -->
                            {% if end_page < total_pages %}
                                {% if end_page < total_pages - 1 %}
                                    <li class="page-item disabled">
                                        <a class="page-link">...</a>
                                    </li>
                                {% endif %}
                                <li class="page-item">
                                    <a class="page-link"
                                       href="{{ url_for('clientes') }}?page={{ total_pages }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}">{{ total_pages }}</a>
                                </li>
                            {% endif %}

                            <!-- Next Page Link -->
                            <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{{ url_for('clientes') }}?page={{ page + 1 }}&per_page={{ per_page }}&order_by={{ order_by }}&order={{ order }}"
                                   aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <!-- Pagination End -->

                </div> <!-- card-body end -->
            </div> <!-- card end -->
        </div> <!-- col end -->
    </div> <!-- row end -->
</div> <!-- main-content end -->

{% include 'parts/foot.jinja2' %}

<script>
    function whatsappModal(name, phone) {
        const whatsappModal = new bootstrap.Modal(document.getElementById('whatsappModal'));
        document.querySelector('#whatsappModal .cliente-name').textContent = name;
        document.querySelector('#whatsappModal #confirmSend').onclick = function () {
            const message = document.querySelector('#whatsappModal #whatsappMessage').value;
            const url = `https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
        }
        document.querySelector('#whatsappModal #confirmSend2').onclick = function () {
            const message = document.querySelector('#whatsappModal #whatsappMessage').value;

        }
        whatsappModal.show();
    }
</script>

<!-- Modal whatsapp -->
<div class="modal fade" id="whatsappModal" tabindex="-1" aria-labelledby="whatsappModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="whatsappModalLabel">Enviar mensagem para: <span class="cliente-name"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="clientPhone">
                <textarea class="form-control" id="whatsappMessage" placeholder="Digite sua mensagem aqui..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="confirmSend">Enviar manual</button>
                <button type="button" class="btn btn-success" id="confirmSend2">Enviar auto.</button>
            </div>
        </div>
    </div>
</div>

</body>
</html>
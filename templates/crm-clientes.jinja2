<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Clientes | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Clientes</h2>
    </div>


    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th scope="col">Nome</th>
                                <th scope="col">E-mail</th>
                                <th scope="col">Telefone</th>
                                <th scope="col">Ações</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in items %}
                                <tr>
                                    <td>{{ item.name }}</td>
                                    <td>{{ item.email }}</td>
                                    <td>{{ item.phone }}</td>
                                    <td>
                                        <a href="#" class="btn btn-sm btn-primary"><i
                                                class="fas fa-eye"></i></a>
                                        <a href="#" class="btn btn-sm btn-warning"><i
                                                class="fas fa-edit"></i></a>
                                        <a href="#" class="btn btn-sm btn-danger"><i
                                                class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% include 'parts/foot.jinja2' %}
</body>
</html>
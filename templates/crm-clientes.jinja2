<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Clientes | {{ crm_name }}</title>
    {% include 'parts/head.jinja2' %}
</head>
<body>
<!-- Mobile Header -->
<div class="mobile-header">
    <button class="navbar-toggler" id="sidebarToggle">
        <i class="fas fa-bars"></i>
    </button>
    <h4 class="m-0"><i class="fas fa-cut me-2"></i> {{ crm_name }}</h4>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
{% include 'parts/sidebar.jinja2' %}

<!-- Main Content -->
<div class="main-content">
    <div class="d-lg-none mb-3">
        <button class="btn btn-primary btn-sm" id="mobileToggle">
            <i class="fas fa-bars me-1"></i> Menu
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Clientes</h2>
    </div>


    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th scope="col">
                                    <a href="{{ url_for('clientes') }}?page={{ page }}&order_by=name&order={{ 'asc' if order_by == 'name' and order == 'desc' else 'desc' }}">
                                        Nome
                                        {% if order_by == 'name' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">
                                    <a href="{{ url_for('clientes') }}?page={{ page }}&order_by=email&order={{ 'asc' if order_by == 'email' and order == 'desc' else 'desc' }}">
                                        E-mail
                                        {% if order_by == 'email' %}
                                            <i class="fas fa-sort-{{ 'up' if order == 'asc' else 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th scope="col">Telefone</th> <!-- Add sorting link if needed -->
                                <th scope="col">Ações</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if items %}
                                {% for item in items %}
                                    <tr>
                                        <td>{{ item.name }}</td>
                                        <td>{{ item.email }}</td>
                                        <td>{{ item.phone }}</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-primary"><i
                                                    class="fas fa-eye"></i></a>
                                            <a href="#" class="btn btn-sm btn-warning"><i
                                                    class="fas fa-edit"></i></a>
                                            <a href="#" class="btn btn-sm btn-danger"><i
                                                    class="fas fa-trash"></i></a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Nenhum cliente encontrado.</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Start -->
                    {% if total_pages > 0 %}
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <!-- Previous Page Link -->
                                <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('clientes', page=page - 1, order_by=order_by, order=order) }}"
                                       aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>

                                <!-- Page Number Links -->
                                {% for page_num in range(1, total_pages + 1) %}
                                    <li class="page-item {% if page_num == page %}active{% endif %}">
                                        <a class="page-link"
                                           href="{{ url_for('clientes') }}?page={{ page_num }}&order_by={{ order_by }}&order={{ order }}">{{ page_num }}</a>
                                    </li>
                                {% endfor %}

                                <!-- Next Page Link -->
                                <li class="page-item {% if page >= total_pages %}disabled{% endif %}">
                                    <a class="page-link"
                                       href="{{ url_for('clientes') }}?page={{ page + 1 }}&order_by={{ order_by }}&order={{ order }}"
                                       aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    {% endif %}
                    <!-- Pagination End -->

                </div> <!-- card-body end -->
            </div> <!-- card end -->
        </div> <!-- col end -->
    </div> <!-- row end -->
</div> <!-- main-content end -->
{% include 'parts/foot.jinja2' %}
</body>
</html>